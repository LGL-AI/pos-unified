{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pos-unified",
  "workers_dev": true,
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pos_unified", "database_id": "4a07644e-6038-4482-a90f-e55c6c2ebd8d", "migrations_dir": "migrations" }
  ],
  "vars": {
    "ORDERING_ENABLED": "true"
  },
  "secrets": {
    "required": ["SESSION_SECRET", "POS_STAFF_PASSWORD"]
  }
}
