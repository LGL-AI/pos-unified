{
  "name": "lotus-pos-cloud-d1",
  "version": "2.6.0-rc.4",
  "private": true,
  "type": "module",
  "description": "Four Lotus POS UIs sharing one Cloudflare Worker and D1",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "test:rc2": "node --test tests/payment-first.test.mjs",
    "test:rc3": "node --test tests/payment-first.test.mjs tests/counter-raster.test.mjs",
    "check:d1": "node scripts/check-d1-ready.mjs"
  },
  "devDependencies": { "wrangler": "^4.0.0" },
  "engines": { "node": ">=22" }
}
